`timescale 1ns / 1ps
`include "game_defines.v"

//============================================================
// PS/2 接收底层模块
// 功能：接收 PS/2 键盘发送的 11 位数据帧
// PS/2 一帧格式：
// start(0) + 8位数据(低位先发) + odd parity + stop(1)
//============================================================
module PS2_Receiver (
    input  wire       clk,
    input  wire       rst_n,
    input  wire       ps2_clk,
    input  wire       ps2_dat,

    output reg  [7:0] scan_code,
    output reg        code_valid
);

    //------------------------------------------------------------
    // 1. 同步 PS/2 时钟和数据，防止异步输入直接进入逻辑
    //------------------------------------------------------------
    reg [2:0] ps2_clk_sync;
    reg [2:0] ps2_dat_sync;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            ps2_clk_sync <= 3'b111;
            ps2_dat_sync <= 3'b111;
        end else begin
            ps2_clk_sync <= {ps2_clk_sync[1:0], ps2_clk};
            ps2_dat_sync <= {ps2_dat_sync[1:0], ps2_dat};
        end
    end

    wire ps2_clk_fall = (ps2_clk_sync[2:1] == 2'b10);
    wire ps2_dat_s    = ps2_dat_sync[2];

    //------------------------------------------------------------
    // 2. 接收 11 位 PS/2 帧
    //------------------------------------------------------------
    reg [3:0]  bit_cnt;
    reg [10:0] frame;

    // 超时保护：如果收了一半突然没信号，就重新开始
    reg [17:0] timeout_cnt;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            bit_cnt     <= 4'd0;
            frame       <= 11'd0;
            scan_code   <= 8'd0;
            code_valid  <= 1'b0;
            timeout_cnt <= 18'd0;
        end else begin
            code_valid <= 1'b0;

            if (ps2_clk_fall) begin
                timeout_cnt <= 18'd0;

                frame[bit_cnt] <= ps2_dat_s;

                if (bit_cnt == 4'd10) begin
                    bit_cnt <= 4'd0;

                    // frame[0]      = start bit，应该为 0
                    // frame[8:1]    = 8 位扫描码
                    // frame[9]      = parity
                    // ps2_dat_s     = stop bit，应该为 1
                    // PS/2 使用奇校验：数据位和校验位异或结果应为 1
                    if ((frame[0] == 1'b0) &&
                        (ps2_dat_s == 1'b1) &&
                        ((^({frame[8:1], frame[9]})) == 1'b1)) begin
                        scan_code  <= frame[8:1];
                        code_valid <= 1'b1;
                    end
                end else begin
                    bit_cnt <= bit_cnt + 4'd1;
                end
            end else begin
                if (bit_cnt != 4'd0) begin
                    if (timeout_cnt >= 18'd200_000) begin
                        bit_cnt     <= 4'd0;
                        timeout_cnt <= 18'd0;
                    end else begin
                        timeout_cnt <= timeout_cnt + 18'd1;
                    end
                end else begin
                    timeout_cnt <= 18'd0;
                end
            end
        end
    end

endmodule


//============================================================
// PS/2 键盘控制模块
// 输出接口尽量做成和你原来的 Input_Controller 一样：
// dir_out      ：方向
// start_pulse  ：开始脉冲
// pause_pulse  ：暂停脉冲
//============================================================
module PS2_Keyboard_Controller (
    input  wire       clk,
    input  wire       rst_n,

    input  wire       ps2_clk,
    input  wire       ps2_dat,

    output reg  [1:0] dir_out,
    output reg        start_pulse,
    output reg        pause_pulse
);

    //------------------------------------------------------------
    // 1. 接收扫描码
    //------------------------------------------------------------
    wire [7:0] scan_code;
    wire       code_valid;

    PS2_Receiver u_ps2_rx (
        .clk        (clk),
        .rst_n      (rst_n),
        .ps2_clk    (ps2_clk),
        .ps2_dat    (ps2_dat),
        .scan_code  (scan_code),
        .code_valid (code_valid)
    );

    //------------------------------------------------------------
    // 2. PS/2 Set 2 扫描码定义
    //------------------------------------------------------------
    localparam SC_EXT   = 8'hE0;   // 扩展码前缀
    localparam SC_BREAK = 8'hF0;   // 松开按键前缀

    // WASD
    localparam SC_W     = 8'h1D;
    localparam SC_A     = 8'h1C;
    localparam SC_S     = 8'h1B;
    localparam SC_D     = 8'h23;

    // 方向键，前面会带 E0
    localparam SC_UP    = 8'h75;
    localparam SC_DOWN  = 8'h72;
    localparam SC_LEFT  = 8'h6B;
    localparam SC_RIGHT = 8'h74;

    // 功能键
    localparam SC_ENTER = 8'h5A;
    localparam SC_SPACE = 8'h29;
    localparam SC_P     = 8'h4D;

    //------------------------------------------------------------
    // 3. 处理 E0 / F0 前缀
    //------------------------------------------------------------
    reg ext_seen;
    reg break_seen;

    // 防止 Enter / P / Space 长按时自动重复触发很多次
    reg enter_down;
    reg space_down;
    reg p_down;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            dir_out     <= `DIR_RIGHT;
            start_pulse <= 1'b0;
            pause_pulse <= 1'b0;

            ext_seen    <= 1'b0;
            break_seen  <= 1'b0;

            enter_down  <= 1'b0;
            space_down  <= 1'b0;
            p_down      <= 1'b0;
        end else begin
            start_pulse <= 1'b0;
            pause_pulse <= 1'b0;

            if (code_valid) begin
                //------------------------------------------------
                // 扩展码前缀 E0
                //------------------------------------------------
                if (scan_code == SC_EXT) begin
                    ext_seen <= 1'b1;
                end

                //------------------------------------------------
                // 松开前缀 F0
                //------------------------------------------------
                else if (scan_code == SC_BREAK) begin
                    break_seen <= 1'b1;
                end

                //------------------------------------------------
                // 真正的按键扫描码
                //------------------------------------------------
                else begin
                    //------------------------------------------------
                    // 按键松开
                    //------------------------------------------------
                    if (break_seen) begin
                        if (!ext_seen) begin
                            case (scan_code)
                                SC_ENTER: enter_down <= 1'b0;
                                SC_SPACE: space_down <= 1'b0;
                                SC_P:     p_down     <= 1'b0;
                                default: ;
                            endcase
                        end

                        ext_seen   <= 1'b0;
                        break_seen <= 1'b0;
                    end

                    //------------------------------------------------
                    // 按键按下
                    //------------------------------------------------
                    else begin
                        if (ext_seen) begin
                            // 方向键：E0 75 / E0 72 / E0 6B / E0 74
                            case (scan_code)
                                SC_UP:    dir_out <= `DIR_UP;
                                SC_DOWN:  dir_out <= `DIR_DOWN;
                                SC_LEFT:  dir_out <= `DIR_LEFT;
                                SC_RIGHT: dir_out <= `DIR_RIGHT;
                                default: ;
                            endcase

                            ext_seen <= 1'b0;
                        end else begin
                            // 普通键：WASD / Enter / P / Space
                            case (scan_code)
                                SC_W: dir_out <= `DIR_UP;
                                SC_S: dir_out <= `DIR_DOWN;
                                SC_A: dir_out <= `DIR_LEFT;
                                SC_D: dir_out <= `DIR_RIGHT;

                                SC_ENTER: begin
                                    if (!enter_down) begin
                                        start_pulse <= 1'b1;
                                        enter_down  <= 1'b1;
                                    end
                                end

                                SC_SPACE: begin
                                    if (!space_down) begin
                                        pause_pulse <= 1'b1;
                                        space_down  <= 1'b1;
                                    end
                                end

                                SC_P: begin
                                    if (!p_down) begin
                                        pause_pulse <= 1'b1;
                                        p_down      <= 1'b1;
                                    end
                                end

                                default: ;
                            endcase
                        end
                    end
                end
            end
        end
    end

endmodule
